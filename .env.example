# Copy to backend/.env for local (non-Docker) runs. Docker Compose sets these itself.
DATABASE_URL=postgresql+psycopg2://mplad:mplad@localhost:5432/mplad
DATA_DIR=../data

# Comma-separated frontend origins allowed by CORS (production only).
# CORS_ORIGINS=https://your-app.vercel.app

# Postgres container credentials (used by docker-compose)
POSTGRES_USER=mplad
POSTGRES_PASSWORD=mplad
POSTGRES_DB=mplad

# Frontend production build only — the deployed backend origin.
# VITE_API_BASE=https://your-backend.onrender.com
